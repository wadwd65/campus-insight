# Copy to .env.local. These values are read only by the Node server.
# npm run dev / npm run preview: same-origin Vite middleware.
# npm run build && npm start: production Node server, serving dist + API.
# A dist-only static host uses local fallback unless it also provides this API.
# Never use VITE_ for secrets. .env.local is excluded from Git and release packages.

LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# Or point to a UTF-8 file containing only the key:
# LLM_API_KEY_FILE=C:/path/to/key.txt

# Startup defaults to 127.0.0.1:5191. Set HOST / PORT in the server environment if needed.

# Accounts / circles: server-private SQLite, never put this in public/ or dist/.
# Defaults to .campus-data beside the program; use a persistent disk in the cloud.
# CAMPUS_DATA_DIR=/data/campus
# Public deployments MUST set the exact HTTPS origin, without trailing slash.
# APP_ORIGIN=https://campus.example.com
# Users register directly and create their own circles. No setup token is needed.

# Same program: self-hosted (independent users) or shared (site operator).
# Run npm run configure for guided configuration. Modes do not change permissions.
CAMPUS_DEPLOYMENT=self-hosted
CAMPUS_SITE_NAME=校园档案
# Used by the optional HTTPS Compose template; no protocol or slash:
# CAMPUS_DOMAIN=campus.example.com
# Optional public generic admin download: release-download/campus-insight-admin.zip
# Only put the verified, credential-free deployment ZIP there; never a data backup.
