# 依赖
node_modules/

# 构建产物
dist/
dist-ssr/
*.local

# 冒烟测试的临时 SSR 产物（npm run smoke 每次重新生成）
.smoke-out/

# 调试用浏览器的用户数据目录（含登录态，绝不提交）
# 同时已在 vite.config.js 的 watch.ignored 里排除 —— 不排除会导致 HMR 死循环
.browser-profile/

# 本机跑图/抠图的临时脚本与中间产物（只为生成素材，不属于产品代码）
.workbuddy-gen/

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 操作系统
.DS_Store
Thumbs.db

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 环境变量（含密钥，绝不提交）
.env
.env.*
!.env.example

