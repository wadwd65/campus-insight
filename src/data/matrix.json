{
  "version": 1,
  "note": "选项 → 属性增量矩阵。Python 生成端与 JS 计算端共用这一份，避免两处定义漂移。设计依据见 docs/设计-01-问题与映射矩阵.md 第二节、第四节。",
  "attributes": [
    { "key": "academic", "label": "学术投入", "axis": "学术力" },
    { "key": "social", "label": "社交活跃", "axis": "社交力" },
    { "key": "sport", "label": "运动活力", "axis": "运动力" },
    { "key": "food", "label": "美食热情", "axis": "美食力" },
    { "key": "night", "label": "夜猫程度", "axis": null },
    { "key": "plan", "label": "计划性", "axis": null },
    { "key": "novelty", "label": "尝鲜度", "axis": null },
    { "key": "resilience", "label": "抗压韧性", "axis": null }
  ],
  "derived": [
    {
      "key": "buddhist",
      "label": "佛系指数",
      "axis": "佛系指数",
      "formula": { "plan": -1, "resilience": 1 },
      "why": "计划性低 + 抗压高才是真佛系；计划性低但抗压也低那是焦虑，不是佛系"
    }
  ],
  "questions": [
